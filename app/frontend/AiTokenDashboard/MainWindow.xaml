<Window x:Class="AiTokenDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage by Department - Copilot"
        Height="850" Width="1100"
        Background="#F5F6F8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <StackPanel Margin="0,0,0,16" HorizontalAlignment="Left">
                <TextBlock Text="AI usage by department - Microsoft 365 Copilot" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="HistoryText" Text="" FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Controls -->
            <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Data source:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ModeCombo" Width="200" VerticalAlignment="Center">
                        <ComboBoxItem Content="Demo data"/>
                        <ComboBoxItem Content="Live Microsoft 365"/>
                    </ComboBox>

                    <StackPanel x:Name="TenantPanel" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="Tenant ID / domain:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TenantIdBox" Width="220" VerticalAlignment="Center"
                                 ToolTip="e.g. contoso.onmicrosoft.com"/>
                    </StackPanel>

                    <Button x:Name="ActionButton" Content="Load demo data" Margin="16,0,0,0" Padding="14,6" VerticalAlignment="Center"/>

                    <TextBlock x:Name="StatusText" Text="" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" MaxWidth="320"/>
                </StackPanel>
            </Border>

            <!-- KPI row -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total tokens" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="KpiTokens" Text="--" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total cost" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="KpiCost" Text="--" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Departments tracked" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="KpiDepartments" Text="--" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Active Copilot users" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="KpiUsers" Text="--" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Cost by department + trend -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Cost by department" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel x:Name="DeptBarsPanel"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="18" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Daily token usage" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Canvas x:Name="TrendCanvas" Height="160"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Department summary + by app -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Department summary" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DataGrid x:Name="DeptGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Department" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Users" Binding="{Binding Users}" Width="60"/>
                                <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat='${0:N2}'}" Width="80"/>
                                <DataGridTextColumn Header="Avg/user" Binding="{Binding AvgCostPerUser, StringFormat='${0:N2}'}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="18" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Usage by app" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DataGrid x:Name="AppGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="App" Binding="{Binding App}" Width="*"/>
                                <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat='${0:N2}'}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top users -->
            <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,16" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Top users by token usage" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="Transparent" BorderThickness="0" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="*"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="140"/>
                            <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat=N0}" Width="90"/>
                            <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat='${0:N2}'}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,0,0,24"
                       Text="Token and cost figures are modeled estimates, in both demo and live mode. Microsoft Graph's Copilot usage report does not expose raw token counts. See README-APP.md for what's measured vs. modeled, and for the differentiators this app adds on top of Microsoft's native reporting: department rollups, cost modeling, history retained beyond Microsoft's 28-day reporting window, and a foundation for cross-vendor AI usage in one view."/>

        </StackPanel>
    </ScrollViewer>
</Window>
